{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(python3:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(sed -n:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)"
    ],
    "deny": [
      "EnterWorktree",
      "Agent(isolation:worktree)",
      "Bash(git worktree add *)",
      "Bash(git worktree move *)",
      "Bash(git * worktree add *)",
      "Bash(git * worktree move *)",
      "Bash(claude --worktree *)",
      "Bash(claude -w *)",
      "Bash(claude * --worktree *)",
      "Bash(claude * -w *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterWorktree|Agent|Task|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/worktree-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/worktree-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
