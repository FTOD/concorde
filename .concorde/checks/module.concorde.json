{
  "checks": [
    {
      "id": "check.concorde.tests",
      "argv": [
        ".venv/bin/python",
        "-m",
        "pytest",
        "-p",
        "no:cacheprovider",
        "-n",
        "4",
        "tests/concorde/test_errors.py",
        "tests/concorde/acceptance",
        "tests/concorde/development"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "conftest.py",
        "prompts",
        "protocol",
        "pyproject.toml",
        "scripts",
        "specs",
        "src",
        "tests/concorde/acceptance",
        "tests/concorde/development",
        "tests/concorde/distribution",
        "tests/concorde/support",
        "tests/concorde/test_errors.py",
        "tests/concorde/validation/project.py"
      ]
    }
  ]
}
