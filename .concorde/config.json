{
  "profile_version": 17,
  "registry": ".concorde/specs.json",
  "protocol": {
    "version": "12.0.0",
    "digest": "sha256:675409cd311e3e92497278bc5648fc670db572e7e5f784baf44f4eb8c22f1e14"
  },
  "checks": [
    {
      "id": "check.spec.model",
      "module": "module.spec",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-p",
        "no:cacheprovider",
        "-n",
        "4",
        "tests/concorde/spec/test_module_model.py"
      ],
      "timeout_seconds": 120,
      "inputs": [
        "src",
        "protocol",
        "tests/concorde/spec"
      ]
    },
    {
      "id": "check.views.publication-types",
      "module": "module.views",
      "argv": [
        "{python}",
        "scripts/development/check-docsite-types.py"
      ],
      "timeout_seconds": 120,
      "inputs": [
        "docsite/tsconfig.json",
        "docsite/plugins/scoped-content",
        "docsite/src",
        "docsite/package.json",
        "docsite/package-lock.json",
        "scripts/development/check-docsite-types.py"
      ]
    },
    {
      "id": "check.views.repository-regressions",
      "module": "module.views",
      "argv": [
        "{python}",
        "docsite/tests/repository/run-checks.py"
      ],
      "timeout_seconds": 600,
      "inputs": [
        "prompts",
        "src",
        "protocol",
        "specs",
        "docs",
        "scripts",
        "tests",
        "concorde.json",
        "pyproject.toml",
        "README.md",
        ".concorde/config.json",
        ".concorde/specs.json",
        ".github/workflows/deploy-docsite.yml",
        "docsite/README.md",
        "docsite/docusaurus.config.ts",
        "docsite/package.json",
        "docsite/package-lock.json",
        "docsite/plugins",
        "docsite/scaffold",
        "docsite/scripts",
        "docsite/custom-docs",
        "docsite/sidebars.specs.ts",
        "docsite/site.json",
        "docsite/src",
        "docsite/static",
        "docsite/tests",
        "docsite/tsconfig.json",
        "docsite/vitest.config.ts"
      ]
    },
    {
      "id": "check.issues.store",
      "module": "module.issues",
      "argv": [
        "{python}",
        "scripts/issues.py",
        "check"
      ],
      "timeout_seconds": 60,
      "inputs": [
        ".concorde/issues",
        ".concorde/config.json",
        ".concorde/specs.json",
        "scripts/issues.py",
        "src"
      ]
    },
    {
      "id": "check.checks.runtime",
      "module": "module.harness.checks",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-p",
        "no:cacheprovider",
        "-n",
        "4",
        "tests/concorde/harness/checks"
      ],
      "timeout_seconds": 300,
      "inputs": [
        "pyproject.toml",
        "conftest.py",
        "tests/concorde/support",
        "src",
        "tests/concorde/harness"
      ]
    }
  ]
}
