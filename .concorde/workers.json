{
  "schema_version": 2,
  "enabled_models": {
    "gpt-6-astra": {},
    "gpt-6.1-sol": {},
    "claude-opus-5-5": {}
  },
  "default": {
    "backend": "pi",
    "model": "gpt-6-astra",
    "reasoning": "medium"
  },
  "operations": {
    "spec_panel": {
      "workers": {
        "reviewer1": {
          "model": "claude-opus-5-5"
        },
        "reviewer2": {
          "model": "gpt-6-astra",
          "reasoning": "high"
        },
        "reviewer3": {
          "model": "gpt-6.1-sol",
          "reasoning": "medium"
        },
        "architect1": {
          "model": "gpt-6-astra",
          "reasoning": "high"
        },
        "architect2": {
          "model": "gpt-6.1-sol",
          "reasoning": "high"
        }
      }
    },
    "plan_review": {
      "workers": {
        "reviewer": {
          "model": "gpt-6.1-sol"
        }
      }
    },
    "general": {
      "default": {
        "model": "gpt-6.1-sol",
        "reasoning": "medium"
      }
    }
  },
  "runtime": [
    ".venv",
    "node_modules",
    "docsite/node_modules"
  ]
