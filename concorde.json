{
  "schema_version": 6,
  "name": "concorde",
  "version": "9.0.0",
  "description": "Concorde Framework: Spec tooling that checks, serves and publishes architecture Specs, and Operations that run headless Claude Code or pi workers under Spec-derived permissions for a Claude Code or pi main agent",
  "license": "MIT",
  "license_file": "LICENSE",
  "repository": "https://github.com/FTOD/concorde",
  "architecture_profile": 17,
  "runtime": {
    "python": ">=3.11",
    "venv": ".concorde/.venv"
  },
  "package_roots": [
    "docsite",
    "prompts",
    "protocol",
    "scripts",
    "src"
  ],
  "install": {
    "framework_root": ".concorde/framework",
    "receipt": ".concorde/install.json"
  },
  "clients": [
    "claude-code",
    "pi"
  ],
  "tools": {
    "d2": {
      "version": "v0.9.0",
      "url": "https://github.com/d2lang/d2/releases/download/{version}/d2-{version}-{platform}.tar.gz",
