{
  "schema_version": 1,
  "name": "concorde",
  "version": "1.1.0",
  "description": "Standalone module-centered architecture and feature workflow",
  "license": "MIT",
  "license_file": "LICENSE",
  "repository": "https://github.com/FTOD/concorde",
  "architecture_profile": 7,
  "workspace_protocol": 12,
  "delivery_proposal": 8,
  "command_namespace": "concorde",
  "format_lineage": "Command and Markdown template formatting was informed by GitHub Spec Kit; Concorde owns and executes every distributed asset.",
  "commands": [
    "concorde.analyze",
    "concorde.checklist",
    "concorde.clarify",
    "concorde.ask",
    "concorde.context",
    "concorde.deliver",
    "concorde.init",
    "concorde.validate",
    "concorde.constitution",
    "concorde.converge",
    "concorde.fast-loop",
    "concorde.implement",
    "concorde.plan",
    "concorde.specify",
    "concorde.tasks",
    "concorde.taskstoissues"
  ],
  "templates": [
    "checklist-template.md",
    "constitution-template.md",
    "feature-template.md",
    "plan-template.md",
    "reflections-template.md",
    "tasks-template.md"
  ],
  "package_roots": [
    "agent-assets",
    "commands",
    "scripts",
    "src",
    "templates"
  ],
  "integrations": [
    "claude",
    "codex"
  ],
  "install": {
    "framework_root": ".concorde/framework",
    "receipt": ".concorde/install.json",
    "selection": ".concorde/feature.json"
  }
}
