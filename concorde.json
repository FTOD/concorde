{
  "schema_version": 3,
  "name": "concorde",
  "version": "4.0.0",
  "description": "Explicit Domain scopes, Service/Module Specs, and permission-enforced Operations",
  "license": "MIT",
  "license_file": "LICENSE",
  "repository": "https://github.com/FTOD/concorde",
  "architecture_profile": 8,
  "workspace_protocol": 14,
  "delivery_proposal": 10,
  "skill_namespace": "concorde",
  "format_lineage": "Skill and Markdown template formatting was informed by GitHub Spec Kit; Concorde owns and executes every distributed asset.",
  "skills": [
    "concorde-context-assessor",
    "concorde-implementation-worker",
    "concorde-planner",
    "concorde-reader",
    "concorde-spec-author",
    "concorde-task-author"
  ],
  "operations": [
    "concorde-analyze",
    "concorde-ask",
    "concorde-checklist",
    "concorde-clarify",
    "concorde-configure",
    "concorde-constitution",
    "concorde-context",
    "concorde-context-solve",
    "concorde-converge",
    "concorde-deliver",
    "concorde-fast-loop",
    "concorde-implement",
    "concorde-init",
    "concorde-migrate",
    "concorde-plan",
    "concorde-reflections-triage",
    "concorde-resolve-context",
    "concorde-specify",
    "concorde-standard-dev-loop",
    "concorde-tasks",
    "concorde-taskstoissues",
    "concorde-validate"
  ],
  "operation_runtime": {
    "launcher": "scripts/run-operation.py",
    "python": ">=3.11",
    "requirements": "operations/requirements.lock",
    "venv": ".concorde/.venv"
  },
  "viewer": {
    "provider": "Egonex-AI/Understand-Anything",
    "version": "2.9.0",
    "package": "understand-anything-viewer",
    "asset_url": "https://github.com/Egonex-AI/Understand-Anything/releases/download/v2.9.0/understand-anything-viewer.tgz",
    "asset_sha256": "sha256:a8626ff3ad90041e807bfdb8994eefdd986e891593c4759d08222667e5405330",
    "asset_bytes": 794982,
    "node": ">=18",
    "npm_package": "viewer/package.json",
    "npm_lock": "viewer/package-lock.json",
    "install_relative": "share/concorde/understand-anything-viewer",
    "entrypoint": "node_modules/understand-anything-viewer/bin/viewer.mjs",
    "launcher": "scripts/run-viewer.py",
    "graph_paths": [
      ".understand-anything/knowledge-graph.json",
      ".ua/knowledge-graph.json"
    ]
  },
  "templates": [
    "checklist-template.md",
    "constitution-template.md",
    "domain-template.md",
    "feature-template.md",
    "module-template.md",
    "plan-template.md",
    "reflections-template.md",
    "service-template.md",
    "tasks-template.md"
  ],
  "package_roots": [
    "agent-assets",
    "docsite",
    "operations",
    "protocol",
    "scripts",
    "skills",
    "src",
    "templates",
    "viewer"
  ],
  "integrations": [
    "claude",
    "codex"
  ],
  "install": {
    "framework_root": ".concorde/framework",
    "receipt": ".concorde/install.json"
  }
}
