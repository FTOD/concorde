{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorde.dev/interfaces/documentation/build-manifest-v11.schema.json",
  "title": "Concorde Build Manifest 11",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generator", "collections", "pages", "excludedSources", "routeInventory", "featureGraph", "featureGraphCounts", "validation"],
  "properties": {
    "schemaVersion": {"const": 11},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "docusaurusVersion"],
      "properties": {
        "name": {"const": "concorde-docsite"},
        "version": {"type": "string", "minLength": 1},
        "docusaurusVersion": {"type": "string", "minLength": 1}
      }
    },
    "collections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceBase", "routeBase", "include"],
        "properties": {
          "id": {"enum": ["architecture", "features"]},
          "sourceBase": {"const": "specs"},
          "routeBase": {"enum": ["/architecture", "/features"]},
          "include": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "excludedSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "reason"],
        "properties": {
          "sourcePath": {"$ref": "#/$defs/sourcePath"},
          "reason": {"enum": ["temporal-attempt", "non-publication-source", "legacy-source-profile"]}
        }
      }
    },
    "routeInventory": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/route"}},
    "featureGraph": {"const": "feature-graph.json"},
    "featureGraphCounts": {"$ref": "#/$defs/featureGraphCounts"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"const": "passed"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {"name": {"type": "string", "minLength": 1}, "status": {"const": "passed"}}
          }
        }
      }
    }
  },
  "$defs": {
    "sourcePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "route": {"type": "string", "pattern": "^/"},
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetSourcePath", "targetRoute"],
      "properties": {"targetSourcePath": {"$ref": "#/$defs/sourcePath"}, "targetRoute": {"$ref": "#/$defs/route"}}
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "label"],
      "properties": {
        "section": {"enum": ["Architecture", "Features"]},
        "label": {"type": "string", "minLength": 1},
        "parentRoute": {"$ref": "#/$defs/route"}
      }
    },
    "featureRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "title", "outcome", "status", "route", "relation"],
      "properties": {
        "featureId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "route": {"$ref": "#/$defs/route"},
        "relation": {"enum": ["composes", "refines", "depends_on", "composed_by", "refined_by", "depended_on_by", "relates_to"]}
      }
    },
    "featureGraphCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "modules", "edges_by_kind"],
      "properties": {
        "features": {"type": "integer", "minimum": 0},
        "modules": {"type": "integer", "minimum": 0},
        "edges_by_kind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["composes", "refines", "depends_on", "relates_to", "requires"],
          "properties": {
            "composes": {"type": "integer", "minimum": 0},
            "refines": {"type": "integer", "minimum": 0},
            "depends_on": {"type": "integer", "minimum": 0},
            "relates_to": {"type": "integer", "minimum": 0},
            "requires": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "moduleDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceSha256", "kind", "title", "route"],
      "properties": {
        "source": {"$ref": "#/$defs/sourcePath"},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"]},
        "title": {"type": "string", "minLength": 1},
        "route": {"$ref": "#/$defs/route"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourcePath", "sourceSha256", "route", "title", "navigation", "links"],
      "properties": {
        "kind": {"enum": ["module-architecture", "feature-design"]},
        "sourcePath": {"$ref": "#/$defs/sourcePath"},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "route": {"$ref": "#/$defs/route"},
        "title": {"type": "string", "minLength": 1},
        "navigation": {"$ref": "#/$defs/navigation"},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "moduleId": {"type": "string", "minLength": 1},
        "parentId": {"type": "string", "minLength": 1},
        "architectureDiagrams": {"type": "array", "items": {"$ref": "#/$defs/moduleDiagram"}},
        "featureId": {"type": "string", "minLength": 1},
        "moduleRoute": {"$ref": "#/$defs/route"},
        "status": {"type": "string", "minLength": 1},
        "relatedFeatures": {"type": "array", "items": {"$ref": "#/$defs/featureRelation"}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "module-architecture"}}, "required": ["kind"]},
          "then": {"required": ["moduleId", "architectureDiagrams"], "not": {"anyOf": [{"required": ["featureId"]}, {"required": ["moduleRoute"]}, {"required": ["status"]}, {"required": ["relatedFeatures"]}]}}
        },
        {
          "if": {"properties": {"kind": {"const": "feature-design"}}, "required": ["kind"]},
          "then": {"required": ["featureId", "moduleId", "moduleRoute", "status", "relatedFeatures"], "not": {"anyOf": [{"required": ["parentId"]}, {"required": ["architectureDiagrams"]}]}}
        }
      ]
    }
  }
}
