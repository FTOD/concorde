{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorde.dev/interfaces/documentation/feature-graph-v2.schema.json",
  "title": "Concorde Feature Graph 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "source_digest", "modules", "features", "edges", "counts"],
  "properties": {
    "schema_version": {"const": 2},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source_digest": {"$ref": "#/$defs/sha256"},
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "counts": {"$ref": "#/$defs/counts"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "route": {"type": "string", "pattern": "^/"},
    "sourcePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "edgeKind": {"enum": ["composes", "refines", "depends_on", "relates_to", "requires"]},
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "route"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "parent": {"$ref": "#/$defs/id"},
        "route": {"$ref": "#/$defs/route"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "module", "outcome", "route", "source_path", "source_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "module": {"$ref": "#/$defs/id"},
        "outcome": {"type": "string", "minLength": 1},
        "route": {"$ref": "#/$defs/route"},
        "source_path": {"$ref": "#/$defs/sourcePath"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "target", "declared_by"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/edgeKind"},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "interface": {"$ref": "#/$defs/id"},
        "declared_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "requires"}}, "required": ["kind"]},
          "then": {"required": ["interface"]},
          "else": {"not": {"required": ["interface"]}}
        }
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "modules", "edges_by_kind"],
      "properties": {
        "features": {"type": "integer", "minimum": 0},
        "modules": {"type": "integer", "minimum": 0},
        "edges_by_kind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["composes", "refines", "depends_on", "relates_to", "requires"],
          "properties": {
            "composes": {"type": "integer", "minimum": 0},
            "refines": {"type": "integer", "minimum": 0},
            "depends_on": {"type": "integer", "minimum": 0},
            "relates_to": {"type": "integer", "minimum": 0},
            "requires": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
