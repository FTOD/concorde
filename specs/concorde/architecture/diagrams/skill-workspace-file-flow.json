  "cards": [
    {
      "dot": "cyan",
      "title": "Spec Kit file matrix",
      "items": [
        "constitution writes only .specify/memory/constitution.md",
        "clarify/specify read guidance and update abstract.md + design.md; specify creates attempt/checklists/requirements.md",
        "plan writes attempt planning files and durable feature contracts/**; tasks/checklist write tasks.md and checklists/**",
        "implement reads design.md, implementation.md, plan/tasks/checklists and writes code plus task state",
        "analyze only appends reflections; converge appends tasks + reflections; taskstoissues reads tasks and writes external issues"
      ]
    },
    {
      "dot": "emerald",
      "title": "Concorde file matrix",
      "items": [
        "concorde.init writes .concorde/config.json, module.md, design.md, architecture/contracts/**, and architecture/diagrams/** after approval",
        "concorde.context, concorde.validate, and concorde.ask inspect configured or selected sources without file writes",
        "concorde.impl.accept reads the feature trio, module sources, full attempt/, reflections, code, and tests",
        "Acceptance writes implementation.md, may amend module design.md, then removes the selected attempt/"
      ]
    },
    {
      "dot": "violet",
      "title": "Workspace lifetimes",
      "items": [
        ".specify/feature.json selects the workspace used by file-based skills",
        "Durable intent and accepted realization live outside attempt/",
        "Planning and delivery memory lives inside attempt/",
        "Product code and reflections.md remain maintained project state"
      ]
    }
  ]
