{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorde.invalid/contracts/architecture-service-v1.schema.json",
  "title": "Concorde Architecture Service Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "operation": {
      "type": "string",
      "enum": ["init", "context", "validate"]
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
          { "pattern": "(?:^|/)\\.\\.(?:/|$)" },
          { "pattern": "\\\\" }
        ]
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "target", "options"],
      "properties": {
        "schema_version": { "const": 1 },
        "operation": { "$ref": "#/$defs/operation" },
        "target": { "type": "string", "minLength": 1 },
        "options": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "target",
        "status",
        "artifacts",
        "findings",
        "result"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "operation": { "$ref": "#/$defs/operation" },
        "target": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["success", "proposal", "unchanged", "invalid", "conflict", "failed"]
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/safePath" },
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "result": { "type": "object" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "source", "message", "remediation"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^CONCORDE-[A-Z]+-[0-9]{3}$"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        },
        "source": { "$ref": "#/$defs/safePath" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
