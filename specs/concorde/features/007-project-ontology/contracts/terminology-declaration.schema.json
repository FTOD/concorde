{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concorde Terminology Declaration",
  "type": "object",
  "required": ["level_id", "terms"],
  "properties": {
    "level_id": {"type": "string"},
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "meaning", "relationships"],
        "properties": {
          "term": {"type": "string"},
          "meaning": {"type": "string"},
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["predicate", "target"],
              "properties": {
                "predicate": {"type": "string"},
                "target": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
