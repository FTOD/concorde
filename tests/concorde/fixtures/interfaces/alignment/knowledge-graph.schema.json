{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorde.invalid/interfaces/understand-anything-knowledge-graph-pinned.schema.json",
  "title": "Understand Anything Knowledge Graph Compatibility Profile",
  "type": "object",
  "required": ["version", "project", "nodes", "edges", "layers", "tour"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "kind": {"enum": ["codebase", "knowledge", "design"]},
    "project": {"$ref": "#/$defs/project"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}},
    "tour": {"type": "array", "items": {"$ref": "#/$defs/tourStep"}}
  },
  "additionalProperties": true,
  "$defs": {
    "project": {
      "type": "object",
      "required": ["name", "languages", "frameworks", "description", "analyzedAt", "gitCommitHash"],
      "properties": {
        "name": {"type": "string"},
        "languages": {"type": "array", "items": {"type": "string"}},
        "frameworks": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"},
        "analyzedAt": {"type": "string"},
        "gitCommitHash": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "summary", "tags", "complexity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "file", "function", "class", "module", "concept",
            "config", "document", "service", "table", "endpoint", "pipeline", "schema", "resource",
            "domain", "flow", "step",
            "article", "entity", "topic", "claim", "source",
            "page", "screen", "component", "componentSet", "instance", "token"
          ]
        },
        "name": {"type": "string"},
        "filePath": {"type": "string"},
        "lineRange": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "summary": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "complexity": {"enum": ["simple", "moderate", "complex"]},
        "languageNotes": {"type": "string"},
        "domainMeta": {"$ref": "#/$defs/domainMeta"},
        "knowledgeMeta": {"$ref": "#/$defs/knowledgeMeta"},
        "figmaMeta": {"$ref": "#/$defs/figmaMeta"}
      },
      "additionalProperties": true
    },
    "domainMeta": {
      "type": "object",
      "properties": {
        "entities": {"type": "array", "items": {"type": "string"}},
        "businessRules": {"type": "array", "items": {"type": "string"}},
        "crossDomainInteractions": {"type": "array", "items": {"type": "string"}},
        "entryPoint": {"type": "string"},
        "entryType": {"enum": ["http", "cli", "event", "cron", "manual"]}
      },
      "additionalProperties": true
    },
    "knowledgeMeta": {
      "type": "object",
      "properties": {
        "wikilinks": {"type": "array", "items": {"type": "string"}},
        "backlinks": {"type": "array", "items": {"type": "string"}},
        "category": {"type": "string"},
        "content": {"type": "string"}
      },
      "additionalProperties": true
    },
    "figmaMeta": {
      "type": "object",
      "properties": {
        "fileKey": {"type": "string"},
        "nodeId": {"type": "string"},
        "figmaType": {"type": "string"},
        "thumbnailUrl": {"type": "string"},
        "dimensions": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {"width": {"type": "number"}, "height": {"type": "number"}},
          "additionalProperties": true
        },
        "tokenKind": {"enum": ["color", "type", "spacing", "effect", "grid"]},
        "tokenValue": {"type": "string"},
        "prototypeTargets": {"type": "array", "items": {"type": "string"}},
        "componentKey": {"type": "string"}
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "type", "direction", "weight"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "imports", "exports", "contains", "inherits", "implements",
            "calls", "subscribes", "publishes", "middleware",
            "reads_from", "writes_to", "transforms", "validates",
            "depends_on", "tested_by", "configures", "related", "similar_to",
            "deploys", "serves", "provisions", "triggers", "migrates", "documents", "routes", "defines_schema",
            "contains_flow", "flow_step", "cross_domain",
            "cites", "contradicts", "builds_on", "exemplifies", "categorized_under", "authored_by",
            "instance_of", "variant_of", "uses_token"
          ]
        },
        "direction": {"enum": ["forward", "backward", "bidirectional"]},
        "description": {"type": "string"},
        "weight": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "description", "nodeIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "nodeIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "tourStep": {
      "type": "object",
      "required": ["order", "title", "description", "nodeIds"],
      "properties": {
        "order": {"type": "number"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "nodeIds": {"type": "array", "items": {"type": "string"}},
        "languageLesson": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
