{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concorde.invalid/interfaces/feature-workspace-v13.schema.json",
  "title": "Concorde Feature Workspace Protocol 13",
  "oneOf": [
    {"$ref": "#/$defs/deliveryResponse"},
    {"$ref": "#/$defs/deliveryProposal"}
  ],
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"},
          {"pattern": "(?:^|/)\\.\\.(?:/|$)"},
          {"pattern": "\\\\"},
          {"pattern": "/$"}
        ]
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableSafePath": {
      "oneOf": [
        {"$ref": "#/$defs/safePath"},
        {"type": "null"}
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "source", "message", "remediation"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^CONCORDE-[A-Z]+-[0-9]{3}$"},
        "severity": {"enum": ["error", "warning", "info"]},
        "source": {"$ref": "#/$defs/safePath"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "remediation": {"type": "string", "minLength": 1}
      }
    },
    "moduleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "architecture", "responsibility", "boundary"],
      "properties": {
        "module_id": {"type": "string", "pattern": "^module\\.[a-z0-9.-]+$"},
        "architecture": {"$ref": "#/$defs/safePath"},
        "responsibility": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "featureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "title", "module", "feature_path", "outcome", "evidence_status", "reflections_open", "relation"],
      "properties": {
        "feature_id": {"type": "string", "pattern": "^feature\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "module": {"type": "string", "pattern": "^module\\.[a-z0-9.-]+$"},
        "feature_path": {"$ref": "#/$defs/safePath"},
        "outcome": {"type": "string"},
        "evidence_status": {"enum": ["unknown", "partial", "verified", "disagrees"]},
        "reflections_open": {"type": "integer", "minimum": 0},
        "relation": {
          "enum": ["composes", "refines", "depends_on", "composed_by", "refined_by", "depended_on_by", "relates_to"]
        }
      }
    },
    "executableContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_roots", "test_roots"],
      "properties": {
        "source_roots": {"type": "array", "items": {"$ref": "#/$defs/safePath"}, "uniqueItems": true},
        "test_roots": {"type": "array", "items": {"$ref": "#/$defs/safePath"}, "uniqueItems": true}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id", "providing_module", "feature_path",
        "module_architecture", "module_ancestry", "related_features", "executable_context",
        "checklists_dir", "attempt_dir", "attempt_state", "plan", "research", "data_model",
        "quickstart", "tasks", "validation", "reflections", "reflections_open"
      ],
      "properties": {
        "feature_id": {"type": ["string", "null"], "pattern": "^feature\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "providing_module": {"type": "string", "pattern": "^module\\.[a-z0-9.-]+$"},
        "feature_path": {"$ref": "#/$defs/safePath"},
        "module_architecture": {"$ref": "#/$defs/safePath"},
        "module_ancestry": {"type": "array", "items": {"$ref": "#/$defs/moduleSummary"}, "uniqueItems": true},
        "related_features": {"type": "array", "items": {"$ref": "#/$defs/featureSummary"}, "uniqueItems": true},
        "executable_context": {"$ref": "#/$defs/executableContext"},
        "checklists_dir": {"$ref": "#/$defs/nullableSafePath"},
        "attempt_dir": {"$ref": "#/$defs/nullableSafePath"},
        "attempt_state": {"enum": ["unresolved", "absent", "active", "complete"]},
        "plan": {"$ref": "#/$defs/nullableSafePath"},
        "research": {"$ref": "#/$defs/nullableSafePath"},
        "data_model": {"$ref": "#/$defs/nullableSafePath"},
        "quickstart": {"$ref": "#/$defs/nullableSafePath"},
        "tasks": {"$ref": "#/$defs/nullableSafePath"},
        "validation": {"$ref": "#/$defs/nullableSafePath"},
        "reflections": {"$ref": "#/$defs/safePath"},
        "reflections_open": {"type": "integer", "minimum": 0}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "meaning"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "action": {"const": "delete"},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "taskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "incomplete", "malformed"],
      "properties": {
        "complete": {"type": "integer", "minimum": 0},
        "incomplete": {"type": "integer", "minimum": 0},
        "malformed": {"type": "integer", "minimum": 0}
      }
    },
    "checklistSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "complete", "incomplete", "malformed"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0},
        "incomplete": {"type": "integer", "minimum": 0},
        "malformed": {"type": "integer", "minimum": 0}
      }
    },
    "evidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "missing"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0}
      }
    },
    "reflectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "open", "resolved", "dismissed"],
      "properties": {
        "entries": {"type": "integer", "minimum": 0},
        "open": {"type": "integer", "minimum": 0},
        "resolved": {"type": "integer", "minimum": 0},
        "dismissed": {"type": "integer", "minimum": 0}
      }
    },
    "deliveryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "target", "status", "workspace", "changes", "artifacts", "findings", "source_digest"],
      "properties": {
        "schema_version": {"const": 13},
        "tool": {"const": "deliver"},
        "target": {"type": "string", "minLength": 1},
        "status": {"enum": ["eligible", "delivered", "invalid", "conflict", "failed"]},
        "workspace": {"oneOf": [{"$ref": "#/$defs/workspace"}, {"type": "null"}]},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}, "maxItems": 1},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/safePath"}, "uniqueItems": true},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "source_digest": {"$ref": "#/$defs/digest"},
        "proposal_version": {"const": 9},
        "proposal_path": {"$ref": "#/$defs/safePath"},
        "task_summary": {"$ref": "#/$defs/taskSummary"},
        "checklist_summary": {"$ref": "#/$defs/checklistSummary"},
        "evidence_summary": {"$ref": "#/$defs/evidenceSummary"},
        "removed_artifacts": {"type": "array", "items": {"$ref": "#/$defs/safePath"}, "uniqueItems": true},
        "retained_artifacts": {"type": "array", "items": {"$ref": "#/$defs/safePath"}, "uniqueItems": true},
        "retained_digests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "reflection_summary": {"$ref": "#/$defs/reflectionSummary"}
      }
    },
    "deliveryProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_version", "tool", "target", "source_digest", "remove"],
      "properties": {
        "proposal_version": {"const": 9},
        "tool": {"const": "deliver"},
        "target": {"type": "string", "pattern": "^feature\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "remove": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/safePath"}, "uniqueItems": true}
      }
    }
  }
}
